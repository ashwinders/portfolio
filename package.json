{
  "name": "ashwinder.me",
  "version": "1.0.0",
  "description": "Static portfolio site — ashwinder.me",
  "private": true,
  "scripts": {
    "sass:build": "sass src/scss/style.scss src/css/style.css --style compressed --no-source-map",
    "sass:watch": "sass --watch src/scss/style.scss src/css/style.css --style compressed --no-source-map",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Ashwinder Singh",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "prettier": "^3.9.10",
    "sass": "^1.107.1"
  }
}
